# Set these in your hosting dashboard (Render, Railway, VPS...). Do not commit real values.
NODE_ENV=production
PORT=4000
JWT_SECRET=put-a-long-random-string-here          # required in production
DB_FILE=/data/saath.db                            # put the database on a persistent disk

# Online payments (Razorpay). Leave empty to offer "pay after service" only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                          # same secret you set in Razorpay > Webhooks

# Only for the client build (shown on the policies page)
VITE_SUPPORT_EMAIL=support@yourdomain.in

# Service partners. Leave unset to get safe defaults (see README: "Environment switches").
# In production, new partners wait for admin approval and demo shortcuts are off.
#PROVIDER_AUTO_APPROVE=0
#ALLOW_DEMO_PROVIDERS=0
#ALLOW_EARLY_COMPLETE=0

# ---- Alerts and password codes (WhatsApp, SMS, email) ------------------------------------------
# Leave any of these empty and that channel is simply off: in development the message is printed in the
# server console instead, in production it is recorded as "skipped" (see README: "Notifications").
APP_URL=https://yourdomain.in                      # used for the links inside messages
TWILIO_ACCOUNT_SID=                                # one Twilio account sends both SMS and WhatsApp
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=                                   # your Twilio number, or a Messaging Service SID (MG...)
TWILIO_WHATSAPP_FROM=                              # your approved WhatsApp sender, e.g. +14155238886 (sandbox)
RESEND_API_KEY=                                    # email, from resend.com
MAIL_FROM=Saath <no-reply@yourdomain.in>
# The Saath team is told when a new service partner registers (optional):
ADMIN_NOTIFY_PHONE=
ADMIN_NOTIFY_EMAIL=

# ---- Fast2SMS (India SMS for password-reset codes) ----------------------------------------------
FAST2SMS_API_KEY=                                  # from fast2sms.com (OTP route)

# ---- AI chatbot (optional). Without a key the built-in answers are used ---------------------------
ANTHROPIC_API_KEY=
SUPPORT_EMAIL=support@yourdomain.in
#CHAT_MODEL=claude-haiku-5-5
